# Video delivery backend. `self-hosted` reads assets from public/assets and
# public/media. Any other value requires a matching implementation in
# src/lib/video/provider.ts.
VITE_VIDEO_PROVIDER=self-hosted

# Mux environment key. Only needed if VITE_VIDEO_PROVIDER is switched to `mux`.
VITE_MUX_ENV_KEY=

# Plausible analytics domain. Read in src/lib/analytics.ts. Leave blank to
# disable analytics entirely.
VITE_PLAUSIBLE_DOMAIN=

# Server-only (never exposed to the browser, no VITE_ prefix). Used by the
# Vercel function in api/contact.ts to deliver enquiries via the Resend API.
# Set both in the Vercel project settings for Production and Preview.
RESEND_API_KEY=

# Inbox that contact-form enquiries are delivered to. While api/contact.ts
# still sends FROM onboarding@resend.dev, Resend only permits delivery to the
# address that owns the Resend account, so this must match it. Verify a domain
# in the Resend dashboard and change FROM_ADDRESS to send anywhere else.
CONTACT_TO_EMAIL=
